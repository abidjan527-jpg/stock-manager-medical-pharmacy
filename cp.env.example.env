# Example environment variables for Stock Manager (Medical Pharmacy)
# Copy this to cp.env (or .env) and fill in real values for production.

# App
NODE_ENV=development
PORT=3000
APP_NAME=stock-manager-medical-pharmacy

# Database (Postgres example)
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_db
DB_USER=postgres
DB_PASSWORD=changeme

# Authentication / Security
JWT_SECRET=change_this_to_a_strong_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Email / SMTP (for notifications, password resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="Stock Manager <noreply@example.com>"

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# External APIs
API_BASE_URL=http://localhost:3000/api

# Logging / Debug
LOG_LEVEL=info

# Example feature toggles
ENABLE_REGISTRATION=true
ENABLE_EMAIL_NOTIFICATIONS=false
